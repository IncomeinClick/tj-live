# TJ Live configuration
# The setup wizard writes USER_EMAIL / USER_PASS_HASH / SECRET_KEY on first run —
# you normally never edit this file by hand.

# Server
PORT=8800
HOST=127.0.0.1

# Public URL, if you serve it behind a domain (optional)
PUBLIC_URL=

# Login (set by the setup wizard)
USER_EMAIL=
USER_PASS_HASH=
SECRET_KEY=
