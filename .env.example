# TJ Live configuration
# On first run, the in-app setup wizard will create this file for you. To set up manually,
# copy to .env and fill in the values you have — most are optional.

# === Server ===
PORT=8800
HOST=127.0.0.1
PUBLIC_URL=                  # e.g. https://live.yourdomain.com — used in Telegram messages and IG image URLs

# === Authentication (auto-generated by setup wizard) ===
USER_EMAIL=
USER_PASS_HASH=
SECRET_KEY=

# === Telegram notifications (optional — leave blank to disable) ===
TG_BOT_TOKEN=
TG_CHAT_ID=

# === upload-post.com — multi-platform video scheduling ===
# Sign up at https://upload-post.com, paste the JWT API key here.
# (Required for the auto-cut + schedule pipeline. Without this, the dashboard still works but clips can't be scheduled.)
UPLOAD_POST_API_KEY=
UPLOAD_POST_USER=

# === Restream OAuth (optional — only if you pull AI-cut clips from Restream) ===
RESTREAM_CLIENT_ID=
RESTREAM_CLIENT_SECRET=
RESTREAM_REDIRECT_URI=

# === Facebook page (used for posting promos + downloading live VODs) ===
# Either: configure FB_PAGE_ID + FB_ACCESS_TOKEN directly,
# or: point at a Documentor install (DOCUMENTOR_DB + FB_CRED_ID) to reuse its credentials table.
FB_PAGE_ID=
FB_ACCESS_TOKEN=
FB_PAGE_ID_FOR_UPLOAD=       # optional — page ID upload-post.com uploads to
FB_CRED_ID=                  # optional — credential lookup key inside Documentor's DB

# === Documentor integration (optional) ===
# Used to auto-create the recap post after a live ends.
DOCUMENTOR_DB=
DOCUMENTOR_API=
DOCUMENTOR_AUTH=             # bearer string, e.g. "Bearer <documentor-api-token>"
DOCUMENTOR_TH_PROJECT=       # documentor project UUID
DOCUMENTOR_URL=              # public URL of your Documentor install (used by frontend "Open Documentor" buttons)

# === Brevo email (optional — used to email a promo blast when a live is announced) ===
BREVO_API_KEY=
BREVO_LIST_IDS=              # comma-separated list IDs, e.g. 4,5,7
BREVO_SENDER_NAME=
BREVO_SENDER_EMAIL=

# === Tool paths (override per-install — defaults assume binaries on PATH) ===
CLAUDE_CLI=                  # path to the `claude` CLI binary (used to auto-generate promos)
AUTO_EDITOR=auto-editor      # path to auto-editor binary (used by clip cutter)
YTDLP_BIN=yt-dlp             # path to yt-dlp binary (used to download FB VODs)
PROMO_SKILL_PATH=            # absolute path to a SKILL.md describing how Claude should write promos

# === Optional storage ===
MEDIA_DIR=                   # override media directory (default: ./media)
